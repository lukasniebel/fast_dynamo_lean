module

public import Mathlib.Analysis.Fourier.AddCircleMulti
public import Mathlib.Analysis.ODE.Basic
public import Mathlib.Dynamics.TopologicalEntropy.CoverEntropy
public import Mathlib.MeasureTheory.Constructions.Pi
public import Mathlib.MeasureTheory.Integral.IntervalIntegral.Basic

/-!
# A fast dynamo with zero topological entropy

L. Niebel, *A fast dynamo with zero topological entropy*, arXiv:2608.02586v3, Theorem 1.2.

There is an autonomous, divergence-free, Lipschitz velocity field `u` on the flat torus
`𝕋³ = ℝ³/ℤ³` and constants `ε₀, γ₀ > 0` such that for every magnetic diffusivity
`0 < ε ≤ ε₀` the kinematic induction equation

  `∂ₜB = curl (u × B) + ε ΔB,    div B = 0`

has exponential growth at rate at least `γ₀` (so `u` is a *fast dynamo*), while the particle
flow of `u` has zero topological entropy and the ideal (`ε = 0`) induction equation has no
exponential growth.

## Conventions

* `𝕋³` is mathlib's `UnitAddTorus (Fin 3) = Fin 3 → ℝ/ℤ` with its `volume`, the Lebesgue
  (Haar probability) measure; `x 2` is the axial coordinate `x₃`.
* Vectors are `EuclideanSpace`s, so `‖·‖` on `L²(𝕋³;ℂ³)` is the usual `L²` norm.
* Derivatives of fields are taken in the sense of distributions and read on Fourier
  coefficients `f̂(m) = mFourierCoeff f m = ∫ f(x) e^{-2πi m·x} dx`, `m ∈ ℤ³`:
  `∂ⱼ ↦ 2πi mⱼ`, `Δ ↦ -4π²|m|²`.  A distribution on `𝕋³` is determined by its Fourier
  coefficients, so an identity between Fourier coefficients at every `m` is the identity in
  `𝒟'(𝕋³)`.
* `curl (u × B)ᵢ = ∑ⱼ ∂ⱼ(uᵢBⱼ - uⱼBᵢ)` (an algebraic identity, valid with no divergence
  condition).  This divergence form is used so that the equation makes sense for Lipschitz
  `u` and `B ∈ L²` without derivatives of `u`.
* `W^{1,∞}(𝕋³;ℝ³)` is the class of Lipschitz fields; a Lipschitz field is identified with its
  continuous representative.
-/

@[expose] public section

noncomputable section

namespace FastDynamoChallenge

open MeasureTheory UnitAddTorus Filter Topology
open scoped NNReal

/-- The flat three-torus `𝕋³ = ℝ³/ℤ³`. -/
abbrev T3 : Type := UnitAddTorus (Fin 3)

/-- `ℝ³` with the Euclidean norm. -/
abbrev R3 : Type := EuclideanSpace ℝ (Fin 3)

/-- `ℂ³` with the Hermitian norm. -/
abbrev C3 : Type := EuclideanSpace ℂ (Fin 3)

/-- The complex Hilbert space `L²(𝕋³;ℂ³)`. -/
abbrev L2 : Type := Lp C3 2 (volume : Measure T3)

/-- The quotient map `ℝ³ → 𝕋³`. -/
def toTorus (a : R3) : T3 := fun j => (a j : UnitAddCircle)

/-- The real part of a vector of `ℂ³`, as a vector of `ℂ³` with real entries. -/
def re3 (v : C3) : C3 := WithLp.toLp 2 fun i => ((v i).re : ℂ)

/-- `u : 𝕋³ → ℝ³` is divergence-free in the sense of distributions:
`∑ᵢ mᵢ ûᵢ(m) = 0` for every frequency `m ∈ ℤ³`. -/
def IsDivergenceFree (u : T3 → R3) : Prop :=
  ∀ m : Fin 3 → ℤ, ∑ i, (m i : ℂ) * mFourierCoeff (fun x => ((u x i : ℝ) : ℂ)) m = 0

/-- The field `x ↦ e^{2πi m·x} m`, that is `(2πi)⁻¹ ∇e_m`, as an element of `L²(𝕋³;ℂ³)`. -/
def gradChar (m : Fin 3 → ℤ) : L2 :=
  ContinuousMap.toLp 2 volume ℂ
    (mFourier m • ContinuousMap.const T3 (WithLp.toLp 2 fun i => (m i : ℂ) : C3))

/-- `L²_σ(𝕋³) = {B ∈ L²(𝕋³;ℂ³) : div B = 0}`, the orthogonal complement of the gradients of
the Fourier characters.  `B ∈ L²_σ` iff `∑ᵢ mᵢ B̂ᵢ(m) = 0` for every `m ∈ ℤ³`. -/
def L2σ : Submodule ℂ L2 := (Submodule.span ℂ (Set.range gradChar))ᗮ

/-- `B ∈ H²(𝕋³;ℂ³)` for `B ∈ L²(𝕋³;ℂ³)`: `∑_m |m|⁴ |B̂(m)|² < ∞`. -/
def MemH2 (B : T3 → C3) : Prop :=
  Summable fun m : Fin 3 → ℤ =>
    (∑ i, ((m i : ℝ)) ^ 2) ^ 2 * ∑ i, ‖mFourierCoeff (fun x => B x i) m‖ ^ 2

/-- The `i`-th component of the `m`-th Fourier coefficient of the right-hand side
`curl (u × B) + ε ΔB` of the induction equation:
`2πi ∑ⱼ mⱼ ((uᵢBⱼ)^(m) - (uⱼBᵢ)^(m)) - 4π² ε |m|² B̂ᵢ(m)`. -/
def inductionRHS (u : T3 → R3) (ε : ℝ) (B : T3 → C3) (m : Fin 3 → ℤ) (i : Fin 3) : ℂ :=
  2 * Real.pi * Complex.I * ∑ j, (m j : ℂ) *
      (mFourierCoeff (fun x => ((u x i : ℝ) : ℂ) * B x j) m -
        mFourierCoeff (fun x => ((u x j : ℝ) : ℂ) * B x i) m) -
    4 * Real.pi ^ 2 * ε * (∑ j, ((m j : ℝ) : ℂ) ^ 2) * mFourierCoeff (fun x => B x i) m

/-- `S` is a `C₀`-semigroup `e^{t L_{ε,u}}` on `L²_σ` generated by
`L_{ε,u} = curl (u × ·) + εΔ`: a strongly continuous semigroup of bounded operators whose
generator agrees with `L_{ε,u}` on `H² ∩ L²_σ`.  (For `ε > 0` and Lipschitz divergence-free `u`,
`L_{ε,u}` with domain `H² ∩ L²_σ` is itself a generator (Lemma A.1 of the paper), and a generator
has no proper extension that is again a generator, so this property determines `S`: it is the
paper's `e^{t L_{ε,u}}`.) -/
structure IsInductionSemigroup (u : T3 → R3) (ε : ℝ) (S : ℝ≥0 → L2σ →L[ℂ] L2σ) : Prop where
  map_zero : S 0 = ContinuousLinearMap.id ℂ L2σ
  map_add : ∀ s t, S (s + t) = (S s).comp (S t)
  continuous : ∀ B, Continuous fun t => S t B
  generator : ∀ B : L2σ, MemH2 ⇑(B : L2) →
    ∃ D : L2σ, HasDerivWithinAt (fun t : ℝ => (S t.toNNReal B : L2)) (D : L2) (Set.Ici 0) 0 ∧
      ∀ m i, mFourierCoeff (fun x => (D : L2) x i) m = inductionRHS u ε ⇑(B : L2) m i

/-- `T` is a solution group of the ideal induction equation `∂ₜB = curl (u × B)` on `L²_σ`: a
strongly continuous group of bounded operators each of whose orbits `t ↦ T t B` solves the
equation in the sense of distributions, in integrated form:
`B̂(t)(m) - B̂(s)(m) = ∫ₛᵗ (curl (u × B(τ)))^(m) dτ` for all `s, t ∈ ℝ`, `m ∈ ℤ³`. -/
structure IsIdealGroup (u : T3 → R3) (T : ℝ → L2σ →L[ℂ] L2σ) : Prop where
  map_zero : T 0 = ContinuousLinearMap.id ℂ L2σ
  map_add : ∀ s t, T (s + t) = (T s).comp (T t)
  continuous : ∀ B, Continuous fun t => T t B
  weak : ∀ (B : L2σ) (m : Fin 3 → ℤ) (i : Fin 3) (s t : ℝ),
    mFourierCoeff (fun x => (T t B : L2) x i) m - mFourierCoeff (fun x => (T s B : L2) x i) m =
      ∫ τ in s..t, inductionRHS u 0 ⇑(T τ B : L2) m i

/-- `Φ` is the particle flow of `u`: `Φ₀ = id` and `d/dt Φₜ(x) = u(Φₜ(x))`, read on the
universal cover: each trajectory `t ↦ Φₜ(x)` is the image in `𝕋³` of an integral curve
`γ : ℝ → ℝ³` of the periodic lift `a ↦ u(a mod ℤ³)` of `u`. -/
def IsFlow (u : T3 → R3) (Φ : ℝ → T3 → T3) : Prop :=
  ∀ x, Φ 0 x = x ∧ ∃ γ : ℝ → R3,
    IsIntegralCurve γ (fun _ a => u (toTorus a)) ∧ ∀ t, Φ t x = toTorus (γ t)

/-- **Theorem 1.2 of Niebel, arXiv:2608.02586v3.**  There are a Lipschitz, divergence-free,
autonomous velocity `u : 𝕋³ → ℝ³` and constants `ε₀, γ₀ > 0` such that:

1. *(fast dynamo)* for every `0 < ε ≤ ε₀`, the induction semigroup `e^{t L_{ε,u}}` on `L²_σ`
   exists and `‖e^{t L_{ε,u}}‖_{L²_σ → L²_σ} ≥ e^{γ₀ t}` for all `t ≥ 0`; equivalently, the
   paper's growth rate `γ(u, ε) = lim t⁻¹ log ‖e^{t L_{ε,u}}‖` is `≥ γ₀`, and hence
   `liminf_{ε↓0} γ(u, ε) ≥ γ₀`;
2. *(eigenmode)* for every `0 < ε ≤ ε₀` there are `K ≠ 0`, `λ` with `Re λ ≥ γ₀`, and
   `0 ≠ V ∈ H² ∩ L²_σ` of the form `V(y, x₃) = e^{2πiKx₃} b(y)` (all Fourier coefficients
   with `m₃ ≠ K` vanish) with `L_{ε,u} V = λ V`;
3. *(growing real solution)* the real datum `B_in = Re V ∈ H² ∩ L²_σ` is non-zero, and its
   solution `e^{t L_{ε,u}} B_in` is `Re (e^{tλ} V)`, with `‖B(t)‖₂ = e^{t Re λ} ‖B_in‖₂`;
4. *(zero entropy)* the particle flow `Φ` of `u` exists, and every time-`t` map is continuous
   with topological entropy `0`;
5. *(no ideal growth)* the ideal induction equation has exactly one solution group `𝒯₀` on
   `L²_σ`, and `t⁻¹ log ‖𝒯₀(t)‖_{L²_σ → L²_σ} → 0` as `t → ∞`.

The paper states clause 1 for `0 < ε ≤ ε₀` as `γ(u, ε) ≥ γ₀`.  Here it is stated in the form
`‖e^{t L_{ε,u}}‖ ≥ e^{γ₀ t}` for all `t ≥ 0`, which for a `C₀`-semigroup is equivalent to
`γ(u, ε) ≥ γ₀`, since `γ(u, ε) = inf_{t>0} t⁻¹ log ‖e^{t L_{ε,u}}‖`.  Topological entropy is
mathlib's `Dynamics.coverEntropy`, the definition of topological entropy through covers by
dynamical balls (Bowen–Dinaburg), stated for uniform spaces; that on a compact metric space it is
the topological entropy the paper refers to (Hasselblatt–Katok, §2.5e) is a standard fact,
not a theorem of mathlib. -/
theorem fast_dynamo_zero_entropy :
    ∃ u : T3 → R3, (∃ L, LipschitzWith L u) ∧ IsDivergenceFree u ∧
    ∃ ε₀ γ₀ : ℝ, 0 < ε₀ ∧ 0 < γ₀ ∧
    (∀ ε, 0 < ε → ε ≤ ε₀ →
      (∃ S, IsInductionSemigroup u ε S) ∧
      (∀ S, IsInductionSemigroup u ε S → ∀ t : ℝ≥0, Real.exp (γ₀ * t) ≤ ‖S t‖) ∧
      ∃ (K : ℤ) (lam : ℂ) (V : L2σ),
        K ≠ 0 ∧ γ₀ ≤ lam.re ∧ V ≠ 0 ∧ MemH2 ⇑(V : L2) ∧
        (∀ m i, m 2 ≠ K → mFourierCoeff (fun x => (V : L2) x i) m = 0) ∧
        (∀ m i, inductionRHS u ε ⇑(V : L2) m i =
          lam * mFourierCoeff (fun x => (V : L2) x i) m) ∧
        ∃ Bin : L2σ, Bin ≠ 0 ∧ MemH2 ⇑(Bin : L2) ∧
          ⇑(Bin : L2) =ᵐ[volume] (fun x => re3 ((V : L2) x)) ∧
          ∀ S, IsInductionSemigroup u ε S → ∀ t : ℝ≥0,
            ⇑(S t Bin : L2) =ᵐ[volume] (fun x => re3 (Complex.exp (t * lam) • (V : L2) x)) ∧
            ‖S t Bin‖ = Real.exp (t * lam.re) * ‖Bin‖) ∧
    (∃ Φ, IsFlow u Φ) ∧
    (∀ Φ, IsFlow u Φ → ∀ t, Continuous (Φ t) ∧ Dynamics.coverEntropy (Φ t) Set.univ = 0) ∧
    ∃ T, IsIdealGroup u T ∧ (∀ T', IsIdealGroup u T' → T' = T) ∧
      Tendsto (fun t : ℝ => t⁻¹ * Real.log ‖T t‖) atTop (𝓝 0) := by
  sorry

end FastDynamoChallenge
